{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/learning-apply-receipt.schema.json",
  "title": "Apex Forge V2 Learning Apply Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "job_id",
    "run_id",
    "proposal_id",
    "knowledge_version_before",
    "knowledge_version_after",
    "target_file",
    "applied_content",
    "content_sha256",
    "evidence_refs",
    "applied_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "proposal_id": { "type": "string", "minLength": 1 },
    "knowledge_version_before": { "type": "integer", "minimum": 0 },
    "knowledge_version_after": { "type": "integer", "minimum": 1 },
    "target_file": { "type": "string", "minLength": 1 },
    "applied_content": { "type": "string", "minLength": 1 },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "applied_at": { "type": "string" }
  },
  "additionalProperties": false
}
