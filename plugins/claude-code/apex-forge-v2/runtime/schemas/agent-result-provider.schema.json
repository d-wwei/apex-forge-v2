{
  "title": "Apex Forge V2 Provider-Compatible Coding Agent Result",
  "type": "object",
  "required": [
    "verdict",
    "summary",
    "tests",
    "risks",
    "evidence_refs",
    "semantic_evidence",
    "capability_evidence"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status", "detail"],
        "properties": {
          "command": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "skipped"]
          },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "semantic_evidence": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "schema_version",
            "evidence_type",
            "objective",
            "source_refs",
            "claims",
            "uncertainties",
            "acceptance_mapping",
            "affected_files",
            "constraints",
            "unknowns",
            "failure_paths",
            "blast_radius",
            "mitigations",
            "rollback",
            "slices",
            "dependencies",
            "verification",
            "candidate_digest",
            "findings",
            "residual_risks",
            "merge_posture",
            "created_at"
          ],
          "properties": {
            "schema_version": { "type": "string", "const": "v0" },
            "evidence_type": {
              "type": "string",
              "enum": ["context", "risk", "design", "review"]
            },
            "objective": { "type": "string", "minLength": 1 },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "claims": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "uncertainties": {
              "type": "array",
              "items": { "type": "string" }
            },
            "acceptance_mapping": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["criterion", "evidence_ref", "status"],
                "properties": {
                  "criterion": { "type": "string", "minLength": 1 },
                  "evidence_ref": { "type": "string", "minLength": 1 },
                  "status": {
                    "type": "string",
                    "enum": ["supported", "partial", "unverified"]
                  }
                },
                "additionalProperties": false
              }
            },
            "affected_files": {
              "type": "array",
              "items": { "type": "string" }
            },
            "constraints": {
              "type": "array",
              "items": { "type": "string" }
            },
            "unknowns": {
              "type": "array",
              "items": { "type": "string" }
            },
            "failure_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "blast_radius": {
              "type": "array",
              "items": { "type": "string" }
            },
            "mitigations": {
              "type": "array",
              "items": { "type": "string" }
            },
            "rollback": {
              "type": "array",
              "items": { "type": "string" }
            },
            "slices": {
              "type": "array",
              "items": { "type": "string" }
            },
            "dependencies": {
              "type": "array",
              "items": { "type": "string" }
            },
            "verification": {
              "type": "array",
              "items": { "type": "string" }
            },
            "candidate_digest": { "type": "string" },
            "findings": {
              "type": "array",
              "items": { "type": "string" }
            },
            "residual_risks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "merge_posture": {
              "type": "string",
              "enum": ["approve", "block", "conditional"]
            },
            "created_at": { "type": "string" }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "capability_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "capability_id",
          "capability_version",
          "invocation_id",
          "objective",
          "source_refs",
          "claims",
          "uncertainties",
          "verification_refs",
          "output_contract",
          "output",
          "created_at"
        ],
        "properties": {
          "schema_version": { "type": "string", "const": "v0" },
          "capability_id": { "type": "string" },
          "capability_version": { "type": "string" },
          "invocation_id": { "type": "string" },
          "objective": { "type": "string" },
          "source_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "claims": {
            "type": "array",
            "items": { "type": "string" }
          },
          "uncertainties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "verification_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "output_contract": { "type": "string" },
          "output": {
            "type": "object",
            "required": [],
            "properties": {},
            "additionalProperties": false
          },
          "created_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
