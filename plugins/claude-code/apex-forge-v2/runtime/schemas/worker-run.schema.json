{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/worker-run.schema.json",
  "title": "Apex Forge V2 Worker Run",
  "type": "object",
  "required": [
    "schema_version",
    "worker_id",
    "run_id",
    "plan_node_id",
    "status",
    "namespace",
    "sandbox",
    "read_scope",
    "write_scope",
    "verification",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "worker_id": { "type": "string" },
    "run_id": { "type": "string" },
    "plan_node_id": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "running", "claimed", "evidence_submitted", "decision_submitted", "patch_submitted", "queued", "merged", "blocked", "cancelled", "dropped"] },
    "namespace": { "type": "string" },
    "adapter": { "type": "string", "minLength": 1 },
    "executor_id": { "type": "string", "minLength": 1 },
    "execution_class": {
      "type": "string",
      "enum": ["cognitive", "workspace_patch", "deterministic_check", "human_decision"]
    },
    "preferred_mode": {
      "type": "string",
      "enum": ["interactive", "factory", "deterministic", "human"]
    },
    "required_capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "initial_model_tier": {
      "type": "string",
      "enum": ["cheap", "standard", "strong", "deterministic"]
    },
    "model_tier": {
      "type": "string",
      "enum": ["cheap", "standard", "strong", "deterministic"]
    },
    "model_id": { "type": ["string", "null"], "minLength": 1 },
    "model_reason": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "output_contract": { "type": "string", "enum": ["evidence", "patch", "decision"] },
    "evidence_format": {
      "type": "string",
      "enum": ["legacy-v1", "unified-v1"]
    },
    "objective": { "type": "string" },
    "deliverables": { "type": "array", "items": { "type": "string" } },
    "required_evidence": { "type": "array", "items": { "type": "string" } },
    "capability_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "capability_version",
          "mode",
          "required",
          "required_host_capabilities",
          "input_contract",
          "output_contract",
          "protocol_ref"
        ],
        "properties": {
          "capability_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "capability_version": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "mode": { "type": "string", "enum": ["required", "optional", "advisory"] },
          "required": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 0 },
          "target_node_id": { "type": "string" },
          "execution_class": { "type": "string" },
          "required_host_capabilities": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true
          },
          "input_contract": { "type": "string" },
          "output_contract": { "type": "string" },
          "protocol_ref": { "type": "string" },
          "availability": { "type": "string" },
          "certification": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "capability_enforcement": {
      "type": "string",
      "enum": ["shadow", "enforce"]
    },
    "capability_invocation_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sandbox": {
      "type": "object",
      "required": ["type", "path", "status"],
      "properties": {
        "type": { "type": "string", "enum": ["none", "scratch", "worktree"] },
        "path": { "type": "string" },
        "status": { "type": "string", "enum": ["missing", "ready"] },
        "fallback_reason": { "type": "string" }
        ,
        "checkout_owner_id": { "type": ["string", "null"] },
        "checkout_claim_token": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "read_scope": { "type": "array", "items": { "type": "string" } },
    "write_scope": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "attempt": { "type": "integer", "minimum": 0 },
    "last_adapter": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "session_adapter": { "type": ["string", "null"] },
    "claimed_by": { "type": ["string", "null"] },
    "claimed_at": { "type": ["string", "null"] },
    "claim_token": { "type": ["string", "null"] },
    "claim_expires_at": { "type": ["string", "null"] },
    "fencing_token": { "type": "integer", "minimum": 0 },
    "execution_claim_token": { "type": ["string", "null"] },
    "execution_claimed_at": { "type": ["string", "null"] },
    "execution_claim_expires_at": { "type": ["string", "null"] },
    "execution_fencing_token": { "type": "integer", "minimum": 0 },
    "route_id": { "type": ["string", "null"] },
    "factory_executor_id": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
