{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/negative-control-record.schema.json",
  "title": "Apex Forge V2 Negative Control Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "run_id",
    "source_intake_id",
    "mode",
    "status",
    "fault_model",
    "red_command",
    "expected_failure_signature",
    "observed_failure_signature",
    "red_evidence_refs",
    "green_command",
    "green_evidence_refs",
    "restoration_evidence_refs",
    "waiver",
    "revision",
    "last_event_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "record_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "source_intake_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["shadow", "enforce"] },
    "status": {
      "type": "string",
      "enum": ["required", "red_verified", "green_verified", "restored", "waived"]
    },
    "fault_model": { "type": "string" },
    "red_command": { "type": ["string", "null"] },
    "expected_failure_signature": { "type": ["string", "null"] },
    "observed_failure_signature": { "type": ["string", "null"] },
    "red_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "green_command": { "type": ["string", "null"] },
    "green_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "restoration_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "waiver": {
      "anyOf": [
        {
          "type": "object",
          "required": ["risk_id", "approval_id", "reason", "expires_at"],
          "properties": {
            "risk_id": { "type": "string", "minLength": 1 },
            "approval_id": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "expires_at": { "type": "string" }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "last_event_id": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
