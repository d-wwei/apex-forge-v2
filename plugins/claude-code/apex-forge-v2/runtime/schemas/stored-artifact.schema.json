{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/stored-artifact.schema.json",
  "title": "Apex Forge V2 Stored Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "run_id",
    "node_id",
    "type",
    "title",
    "body",
    "refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "artifact_id": { "type": "string" },
    "run_id": { "type": "string" },
    "node_id": { "type": "string" },
    "type": { "type": "string", "enum": ["plan", "evidence", "test", "review", "patch", "decision", "note"] },
    "title": { "type": "string" },
    "body": { "type": "string" },
    "refs": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
