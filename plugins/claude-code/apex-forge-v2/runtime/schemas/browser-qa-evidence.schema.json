{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/browser-qa-evidence.schema.json",
  "title": "Browser QA Evidence Output",
  "type": "object",
  "required": ["url", "browser_provider", "viewport", "user_flows", "screenshots", "console_errors", "network_errors", "behavior_results"],
  "properties": {
    "url": { "type": "string", "minLength": 1 },
    "browser_provider": { "type": "string", "minLength": 1 },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "user_flows": { "type": "array", "items": { "type": ["string", "object"] }, "minItems": 1 },
    "screenshots": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "console_errors": { "type": "array", "items": { "type": ["string", "object"] } },
    "network_errors": { "type": "array", "items": { "type": ["string", "object"] } },
    "accessibility_findings": { "type": "array", "items": { "type": ["string", "object"] } },
    "behavior_results": { "type": "array", "items": { "type": "object" }, "minItems": 1 }
  },
  "additionalProperties": true
}
