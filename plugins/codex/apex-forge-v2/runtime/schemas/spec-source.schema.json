{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/spec-source.schema.json",
  "title": "Apex Forge V2 Normalized Spec Source",
  "type": "object",
  "required": [
    "schema_version",
    "format",
    "path",
    "kind",
    "files",
    "checksum"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "format": {
      "type": "string",
      "enum": ["native", "openspec", "spec-kit"]
    },
    "path": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["file", "directory"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
