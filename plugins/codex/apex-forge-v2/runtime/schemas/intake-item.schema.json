{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/intake-item.schema.json",
  "title": "Apex Forge V2 Intake Item",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "source",
    "type",
    "title",
    "description",
    "priority",
    "risk",
    "affected_area",
    "evidence_refs",
    "triage",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["feature", "bug", "test_failure", "review_feedback", "tech_debt", "risk", "idea", "other"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "affected_area": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "triage": {
      "type": "object",
      "required": ["status", "decision", "target_milestone", "reason"],
      "properties": {
        "status": { "type": "string", "enum": ["new", "accepted", "deferred", "rejected"] },
        "decision": { "type": ["string", "null"] },
        "target_milestone": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
