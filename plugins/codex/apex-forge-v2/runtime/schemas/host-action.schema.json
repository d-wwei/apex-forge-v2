{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/host-action.schema.json",
  "title": "Apex Forge V2 Host Action",
  "type": "object",
  "required": ["schema_version", "action_id", "host_id", "project_id", "kind", "payload", "created_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "action_id": { "type": "string", "minLength": 1 },
    "host_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "project_open",
        "action_claim",
        "artifact_submit",
        "approval_request",
        "progress_report",
        "action_cancel"
      ]
    },
    "payload": { "type": "object" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" }
  },
  "additionalProperties": false
}
