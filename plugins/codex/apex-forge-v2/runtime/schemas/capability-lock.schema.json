{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/capability-lock.schema.json",
  "title": "Apex Forge V2 Capability Lock",
  "type": "object",
  "required": [
    "schema_version",
    "registry_version",
    "public_skill_id",
    "previous_versions",
    "capabilities"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "registry_version": { "type": "string", "minLength": 1 },
    "public_skill_id": { "type": "string", "const": "using-apex-forge" },
    "previous_versions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "version",
          "definition_sha256",
          "protocol_sha256",
          "input_schema_sha256",
          "output_schema_sha256"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "version": { "type": "string", "minLength": 1 },
          "definition_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "protocol_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "input_schema_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_schema_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
