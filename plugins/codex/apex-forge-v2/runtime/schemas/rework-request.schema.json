{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/rework-request.schema.json",
  "title": "Apex Forge V2 Rework Request",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generation",
    "status",
    "candidate_digest",
    "findings",
    "superseded_worker_ids",
    "requested_at",
    "resolved_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "run_id": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["open", "resolved"] },
    "candidate_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "superseded_worker_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requested_at": { "type": "string" },
    "resolved_at": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
