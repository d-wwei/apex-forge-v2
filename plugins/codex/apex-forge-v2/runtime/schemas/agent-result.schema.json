{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/agent-result.schema.json",
  "title": "Apex Forge V2 Coding Agent Result",
  "type": "object",
  "required": ["verdict", "summary", "tests", "risks", "evidence_refs"],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "summary": { "type": "string", "minLength": 1 },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status", "detail"],
        "properties": {
          "command": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skipped"] },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "semantic_evidence": { "$ref": "cognitive-evidence.schema.json" },
    "evidence_artifact": { "$ref": "evidence-submission.schema.json" },
    "capability_evidence": {
      "type": "array",
      "items": { "$ref": "capability-evidence.schema.json" }
    }
  },
  "additionalProperties": false
}
