{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/capability-registry.schema.json",
  "title": "Apex Forge V2 Capability Registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_version",
    "public_skill_id",
    "enforcement_mode",
    "previous_versions",
    "capabilities",
    "bindings"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "registry_version": { "type": "string", "minLength": 1 },
    "public_skill_id": { "type": "string", "const": "using-apex-forge" },
    "enforcement_mode": {
      "type": "string",
      "enum": ["shadow", "enforce"]
    },
    "previous_versions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "uniqueItems": true
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "capability-definition.schema.json" }
    },
    "bindings": {
      "type": "array",
      "items": { "$ref": "capability-binding.schema.json" }
    }
  },
  "additionalProperties": false
}
