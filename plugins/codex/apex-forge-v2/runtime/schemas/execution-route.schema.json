{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/execution-route.schema.json",
  "title": "Apex Forge V2 Execution Route",
  "type": "object",
  "required": [
    "schema_version",
    "route_id",
    "run_id",
    "worker_id",
    "plan_node_id",
    "mode",
    "preferred_mode",
    "user_override",
    "reasons",
    "hints",
    "required_capabilities",
    "method_pack_id",
    "cost_budget",
    "budget_status",
    "usage_policy",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "route_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "worker_id": { "type": "string", "minLength": 1 },
    "plan_node_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["interactive", "factory", "deterministic", "human"] },
    "preferred_mode": { "type": "string", "enum": ["interactive", "factory", "deterministic", "human"] },
    "user_override": { "type": ["string", "null"], "enum": ["interactive", "factory", "deterministic", "human", null] },
    "reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "hints": {
      "type": "object",
      "required": [
        "estimated_duration_minutes",
        "requires_isolation",
        "requires_resume",
        "background",
        "requires_parallel_execution"
      ],
      "properties": {
        "estimated_duration_minutes": { "type": "number", "minimum": 0 },
        "requires_isolation": { "type": "boolean" },
        "requires_resume": { "type": "boolean" },
        "background": { "type": "boolean" },
        "requires_parallel_execution": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "required_capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "method_pack_id": { "type": "string", "minLength": 1 },
    "cost_budget": {
      "type": ["object", "null"],
      "properties": {
        "max_wall_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "max_agent_turns": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "budget_status": {
      "type": "string",
      "enum": ["within_budget", "not_configured"]
    },
    "usage_policy": { "type": "string", "enum": ["record", "fail"] },
    "created_at": { "type": "string" }
  },
  "additionalProperties": false
}
