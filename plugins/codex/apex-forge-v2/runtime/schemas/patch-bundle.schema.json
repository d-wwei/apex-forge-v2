{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/patch-bundle.schema.json",
  "title": "Apex Forge V2 Patch Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "patch_id",
    "worker_id",
    "run_id",
    "plan_node_id",
    "summary",
    "changed_files",
    "operations",
    "evidence_refs",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "patch_id": { "type": "string" },
    "worker_id": { "type": "string" },
    "run_id": { "type": "string" },
    "plan_node_id": { "type": "string" },
    "summary": { "type": "string" },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "properties": {
          "op": { "type": "string", "enum": ["write_text", "replace_text"] },
          "path": { "type": "string" },
          "content": { "type": "string" },
          "old_text": { "type": "string" },
          "new_text": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["submitted", "queued", "merged", "conflict", "dropped"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
