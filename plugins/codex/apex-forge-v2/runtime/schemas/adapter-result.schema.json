{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/adapter-result.schema.json",
  "title": "Apex Forge V2 Adapter Result",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "worker_id",
    "run_id",
    "plan_node_id",
    "adapter",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "result_id": { "type": "string" },
    "worker_id": { "type": "string" },
    "run_id": { "type": "string" },
    "plan_node_id": { "type": "string" },
    "adapter": { "type": "string", "minLength": 1 },
    "executor_id": { "type": "string", "minLength": 1 },
    "model_tier": {
      "type": "string",
      "enum": ["cheap", "standard", "strong", "deterministic"]
    },
    "requested_model": { "type": ["string", "null"], "minLength": 1 },
    "reported_model": { "type": ["string", "null"], "minLength": 1 },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "DECISION"] },
    "failure_kind": {
      "type": ["string", "null"],
      "enum": [
        "timeout",
        "scope_violation",
        "unsupported_change",
        "execution_error",
        "contract_error",
        "agent_reported_failure",
        "no_patch",
        "budget_exceeded",
        "unknown",
        null
      ]
    },
    "command": { "type": "string" },
    "decision": { "type": "string" },
    "summary": { "type": "string" },
    "adapter_version": { "type": "string" },
    "session_id": { "type": ["string", "null"] },
    "executable": { "type": "string" },
    "exit_code": { "type": "integer" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "stdout_tail": { "type": "string" },
    "stderr_tail": { "type": "string" },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "out_of_scope_files": { "type": "array", "items": { "type": "string" } },
    "unsupported_files": { "type": "array", "items": { "type": "string" } },
    "change_summary": {
      "type": "object",
      "required": [
        "changed_file_count",
        "out_of_scope_file_count",
        "unsupported_file_count",
        "list_limit",
        "truncated"
      ],
      "properties": {
        "changed_file_count": { "type": "integer", "minimum": 0 },
        "out_of_scope_file_count": { "type": "integer", "minimum": 0 },
        "unsupported_file_count": { "type": "integer", "minimum": 0 },
        "list_limit": { "type": "integer", "minimum": 1 },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "output_summary": {
      "type": "object",
      "required": [
        "raw_agent_output_bytes",
        "raw_agent_output_truncated",
        "persisted_limit_bytes"
      ],
      "properties": {
        "raw_agent_output_bytes": { "type": "integer", "minimum": 0 },
        "raw_agent_output_truncated": { "type": "boolean" },
        "persisted_limit_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
        "agent_turns": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "cost_evaluation": {
      "type": "object",
      "required": ["status", "exceeded", "unknown"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_CONFIGURED"]
        },
        "exceeded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "actual", "limit"],
            "properties": {
              "metric": { "type": "string" },
              "actual": { "type": "number" },
              "limit": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "unknown": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "capability_evidence_status": {
      "type": "object",
      "required": ["enforcement", "submitted", "missing", "error"],
      "properties": {
        "enforcement": {
          "type": "string",
          "enum": ["shadow", "enforce"]
        },
        "submitted": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "uniqueItems": true
        },
        "missing": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "uniqueItems": true
        },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capability_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence_artifact_ref": { "type": ["string", "null"] },
    "capability_receipt_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "submission_format": {
      "type": "string",
      "enum": ["legacy_projection", "unified"]
    },
    "semantic_evidence_status": {
      "type": "object",
      "required": ["required", "valid", "error"],
      "properties": {
        "required": { "type": "boolean" },
        "valid": { "type": "boolean" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "refs": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" }
  },
  "additionalProperties": false
}
