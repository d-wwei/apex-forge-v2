{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/plan-graph.schema.json",
  "title": "Apex Forge V2 Plan Graph",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "run_id",
    "roadmap_node_id",
    "generated_at",
    "strategy",
    "quality_bar",
    "nodes",
    "edges",
    "parallel_lanes",
    "merge_policy",
    "conflict_policy",
    "verification_policy",
    "evidence_policy"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "plan_id": { "type": "string" },
    "run_id": { "type": "string" },
    "roadmap_node_id": { "type": "string" },
    "source_intake_id": { "type": "string" },
    "source_intake_type": { "type": "string" },
    "source_title": { "type": "string" },
    "affected_area": { "type": "string" },
    "generated_at": { "type": "string" },
    "strategy": { "type": "string" },
    "planning_basis": { "type": "array", "items": { "type": "string" } },
    "quality_bar": { "type": "array", "items": { "type": "string" } },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "lane",
          "objective",
          "parallel_group",
          "dependencies",
          "read_scope",
          "write_scope",
          "deliverables",
          "required_evidence",
          "verification",
          "merge_strategy",
          "risk"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "lane": { "type": "string" },
          "objective": { "type": "string" },
          "parallel_group": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "read_scope": { "type": "array", "items": { "type": "string" } },
          "write_scope": { "type": "array", "items": { "type": "string" } },
          "deliverables": { "type": "array", "items": { "type": "string" } },
          "required_evidence": { "type": "array", "items": { "type": "string" } },
          "verification": { "type": "array", "items": { "type": "string" } },
          "merge_strategy": { "type": "string" },
          "adapter": { "type": "string", "minLength": 1 },
          "execution_class": {
            "type": "string",
            "enum": ["cognitive", "workspace_patch", "deterministic_check", "human_decision"]
          },
          "required_capabilities": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true
          },
          "preferred_mode": {
            "type": "string",
            "enum": ["interactive", "factory", "deterministic", "human"]
          },
          "output_contract": { "type": "string", "enum": ["evidence", "patch", "decision"] },
          "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string", "enum": ["blocks", "feeds", "verifies"] }
        },
        "additionalProperties": false
      }
    },
    "parallel_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "purpose", "node_ids"],
        "properties": {
          "id": { "type": "string" },
          "purpose": { "type": "string" },
          "node_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "merge_policy": { "type": "object" },
    "conflict_policy": { "type": "object" },
    "verification_policy": { "type": "object" },
    "evidence_policy": { "type": "object" },
    "project_knowledge_version": { "type": "integer", "minimum": 0 },
    "project_name": { "type": "string" }
  },
  "additionalProperties": false
}
