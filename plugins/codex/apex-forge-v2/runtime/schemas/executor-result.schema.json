{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/executor-result.schema.json",
  "title": "Apex Forge V2 Worker Executor Result",
  "type": "object",
  "required": [
    "schema_version",
    "executor_id",
    "status",
    "exit_code",
    "duration_ms",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "executor_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "CANCELLED"] },
    "exit_code": { "type": "integer" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "session_id": { "type": ["string", "null"] },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "tool_calls": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string" }
  },
  "additionalProperties": false
}
