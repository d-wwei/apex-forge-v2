{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/method-pack-registry.schema.json",
  "title": "Apex Forge V2 Method Pack Registry",
  "type": "object",
  "required": ["schema_version", "updated_at", "default_pack_id", "packs"],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "updated_at": { "type": "string" },
    "default_pack_id": { "type": "string", "minLength": 1 },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "description", "workflow", "enabled", "quality_gates"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "version": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "workflow": {
            "type": "string",
            "enum": ["quick", "disciplined", "phase_context", "governed"]
          },
          "enabled": { "type": "boolean" },
          "quality_gates": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
