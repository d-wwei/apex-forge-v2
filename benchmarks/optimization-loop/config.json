{
  "schema_version": "v0",
  "campaign_id": "governed-quality-cost-r1",
  "objective": "在不降低质量、安全和 durable closure 的前提下，将 Governed 路径稳定压缩到可接受的时间与 Token 成本。",
  "baseline_sample": "benchmarks/optimization-loop/baseline-governed-r1.json",
  "quality_gates": {
    "public_acceptance": 1,
    "hidden_acceptance": 1,
    "scope_safety": 1,
    "durable_closure": 1,
    "false_completion_count": 0,
    "defect_detection": 1,
    "false_positive_rate": 0
  },
  "route_targets": {
    "quick": {
      "max_wall_ms": 90000,
      "max_total_tokens": 100000,
      "max_cost_ratio_vs_comparator": 1,
      "consecutive_passes": 3
    },
    "disciplined": {
      "max_wall_ms": 180000,
      "max_total_tokens": 200000,
      "max_cost_ratio_vs_comparator": 1.5,
      "consecutive_passes": 3
    },
    "governed": {
      "max_wall_ms": 600000,
      "max_total_tokens": 600000,
      "max_cost_ratio_vs_comparator": 3,
      "consecutive_passes": 3
    }
  },
  "score_weights": {
    "uncached_input_token": 1,
    "cached_input_token": 0.1,
    "output_token": 3,
    "wall_second": 100,
    "model_call": 5000,
    "retry": 10000,
    "rework_rate": 20000,
    "complexity": 20
  },
  "decision": {
    "minimum_improvement_ratio": 0.02,
    "keep_policy": "quality-gates-then-pareto-score",
    "simplicity_tiebreaker": true
  },
  "budgets": {
    "max_experiments": 12,
    "max_total_wall_minutes": 360,
    "max_total_tokens": 15000000,
    "max_consecutive_crashes": 3,
    "max_consecutive_non_improvements": 5,
    "min_free_disk_gib": 150,
    "max_single_artifact_bytes": 10485760
  },
  "benchmark_policy": {
    "timing_runs": "strictly-serial",
    "candidate_runs_per_experiment": 1,
    "confirmation_runs_after_keep": 3,
    "cross_arm_check_after_kept_changes": 3,
    "cross_arm_modes": [
      "raw-agent",
      "v1-skill",
      "plugin-kernel"
    ]
  },
  "safety": {
    "protected_branches": [
      "main",
      "master"
    ],
    "require_clean_worktree": true,
    "allow_hard_reset": false,
    "allow_unbounded_run": false
  },
  "immutable_paths": [
    "benchmarks/optimization-loop/config.json",
    "benchmarks/optimization-loop/baseline-governed-r1.json",
    "benchmarks/plugin-vs-v1/matrix.json",
    "benchmarks/plugin-vs-v1/tasks",
    "schemas",
    "scripts/optimization-loop.mjs",
    "scripts/prepare-product-benchmark.mjs",
    "scripts/product-benchmark-controller.mjs",
    "src/benchmark",
    "src/optimization/quality-cost.mjs"
  ],
  "hypotheses": [
    {
      "id": "GOV-001",
      "description": "把 Governed 的顶层 Agent 探索迁入确定性 controller，减少重复上下文与 CLI 往返。"
    },
    {
      "id": "GOV-002",
      "description": "按节点按需注入 capability protocol，避免每个 worker 加载无关方法文本。"
    },
    {
      "id": "GOV-003",
      "description": "将 context、risk、tests 固定路由到 cheap tier，仅关键实现和最终高风险评审升级模型。"
    },
    {
      "id": "GOV-004",
      "description": "失败只重试局部 worker 和受影响 barrier，不重跑完整 PlanGraph。"
    },
    {
      "id": "GOV-005",
      "description": "把确定性 verification、candidate assembly 和 durable closeout 合并为一次控制器事务。"
    }
  ]
}
