{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/benchmark-result.schema.json",
  "title": "Apex Forge V2 Product Benchmark Result",
  "type": "object",
  "required": [
    "task_id",
    "task_digest",
    "repository",
    "scenario",
    "mode",
    "candidate_digest",
    "attempt",
    "metrics",
    "provenance",
    "evidence"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "task_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repository": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["v1-skill", "cli-kernel", "plugin-kernel"] },
    "candidate_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "metrics": {
      "type": "object",
      "required": [
        "completion",
        "user_actions",
        "recovery",
        "evidence",
        "wall_ms",
        "cost",
        "safety",
        "hidden_acceptance",
        "defect_detection",
        "false_positive",
        "durable_closure",
        "false_completion_claim"
      ],
      "properties": {
        "completion": { "type": "number", "minimum": 0, "maximum": 1 },
        "user_actions": { "type": "number", "minimum": 0 },
        "recovery": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "wall_ms": { "type": "number", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0 },
        "safety": { "type": "number", "minimum": 0, "maximum": 1 },
        "hidden_acceptance": { "type": "number", "minimum": 0, "maximum": 1 },
        "defect_detection": { "type": "number", "minimum": 0, "maximum": 1 },
        "false_positive": { "type": "number", "minimum": 0, "maximum": 1 },
        "durable_closure": { "type": "number", "minimum": 0, "maximum": 1 },
        "false_completion_claim": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_commit",
        "runtime_hash",
        "model",
        "provider",
        "reasoning_effort",
        "runner_version",
        "execution_config_fingerprint",
        "environment_fingerprint",
        "raw_log_refs",
        "artifact_refs",
        "artifact_hashes"
      ],
      "properties": {
        "source_commit": { "type": "string", "minLength": 7 },
        "runtime_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "type": "string", "minLength": 1 },
        "runner_version": { "type": "string", "minLength": 1 },
        "execution_config_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_fingerprint": { "type": "string", "minLength": 1 },
        "raw_log_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifact_hashes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "minProperties": 1
    }
  },
  "additionalProperties": false
}
