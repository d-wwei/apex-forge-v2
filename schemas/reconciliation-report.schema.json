{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/reconciliation-report.schema.json",
  "title": "Apex Forge V2 Reconciliation Report",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "created_at",
    "status",
    "applied",
    "inspection"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "report_id": { "type": "string" },
    "created_at": { "type": "string" },
    "status": { "type": "string", "enum": ["CONSISTENT", "DRIFT", "INVALID", "REPAIRED"] },
    "applied": { "type": "boolean" },
    "inspection": { "type": "object" },
    "post_check": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
