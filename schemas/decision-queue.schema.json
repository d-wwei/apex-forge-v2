{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/decision-queue.schema.json",
  "title": "Apex Forge V2 Decision Queue",
  "type": "object",
  "required": ["schema_version", "run_id", "updated_at", "items"],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "run_id": { "type": "string" },
    "updated_at": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["worker_id", "plan_node_id", "kind", "status", "artifact_ids", "result_ids"],
        "properties": {
          "worker_id": { "type": "string" },
          "plan_node_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["evidence", "decision"] },
          "status": { "type": "string", "enum": ["collected"] },
          "artifact_ids": { "type": "array", "items": { "type": "string" } },
          "result_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

