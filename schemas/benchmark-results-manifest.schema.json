{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/benchmark-results-manifest.schema.json",
  "title": "Apex Forge Product Benchmark Results Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "release_candidate_digest",
    "task_set_digest",
    "results"
  ],
  "properties": {
    "schema_version": { "const": "v0" },
    "release_candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_set_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
