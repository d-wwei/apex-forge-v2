{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/plan-graph.schema.json",
  "title": "Apex Forge V2 Plan Graph",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "run_id",
    "roadmap_node_id",
    "generated_at",
    "strategy",
    "quality_bar",
    "nodes",
    "edges",
    "parallel_lanes",
    "merge_policy",
    "conflict_policy",
    "verification_policy",
    "evidence_policy"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "plan_id": { "type": "string" },
    "run_id": { "type": "string" },
    "roadmap_node_id": { "type": "string" },
    "source_intake_id": { "type": "string" },
    "source_intake_type": { "type": "string" },
    "source_title": { "type": "string" },
    "affected_area": { "type": "string" },
    "generated_at": { "type": "string" },
    "profile": { "type": "string", "enum": ["full", "quick"] },
    "execution_model": {
      "type": "string",
      "enum": ["legacy", "barrier-v1"]
    },
    "barriers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "dependencies", "node_ids"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "delivery-plan",
              "delivery-candidate",
              "delivery-readiness"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "node_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "method_pack": {
      "type": "object",
      "required": ["id", "version", "workflow", "selection_reason", "quality_gates"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "workflow": {
          "type": "string",
          "enum": ["quick", "disciplined", "phase_context", "governed"]
        },
        "selection_reason": { "type": "string", "minLength": 1 },
        "quality_gates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "capability_plan": {
      "type": "object",
      "required": [
        "registry_version",
        "enforcement_mode",
        "router_mode",
        "required",
        "optional",
        "advisory"
      ],
      "properties": {
        "registry_version": { "type": "string", "minLength": 1 },
        "enforcement_mode": {
          "type": "string",
          "enum": ["shadow", "enforce"]
        },
        "router_mode": {
          "type": "string",
          "enum": ["enabled", "disabled"]
        },
        "required": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityBinding" }
        },
        "optional": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityBinding" }
        },
        "advisory": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityBinding" }
        }
      },
      "additionalProperties": false
    },
    "strategy": { "type": "string" },
    "planning_basis": { "type": "array", "items": { "type": "string" } },
    "quality_bar": { "type": "array", "items": { "type": "string" } },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "lane",
          "objective",
          "parallel_group",
          "dependencies",
          "read_scope",
          "write_scope",
          "deliverables",
          "required_evidence",
          "verification",
          "merge_strategy",
          "risk"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "lane": { "type": "string" },
          "objective": { "type": "string" },
          "parallel_group": { "type": "string" },
          "barrier_id": {
            "type": "string",
            "enum": [
              "delivery-plan",
              "delivery-candidate",
              "delivery-readiness"
            ]
          },
          "dispatch_kind": {
            "type": "string",
            "enum": ["coordinator", "subagent", "kernel"]
          },
          "model_tier": {
            "type": "string",
            "enum": ["cheap", "standard", "strong", "deterministic"]
          },
          "fallback_model_tier": {
            "type": ["string", "null"],
            "enum": ["standard", "strong", null]
          },
          "delegation": {
            "type": "object",
            "required": [
              "eligible",
              "default",
              "parallel",
              "main_agent_required"
            ],
            "properties": {
              "eligible": { "type": "boolean" },
              "default": { "type": "boolean" },
              "parallel": { "type": "boolean" },
              "main_agent_required": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "read_scope": { "type": "array", "items": { "type": "string" } },
          "write_scope": { "type": "array", "items": { "type": "string" } },
          "deliverables": { "type": "array", "items": { "type": "string" } },
          "required_evidence": { "type": "array", "items": { "type": "string" } },
          "verification": { "type": "array", "items": { "type": "string" } },
          "merge_strategy": { "type": "string" },
          "adapter": { "type": "string", "minLength": 1 },
          "method_pack_id": { "type": "string", "minLength": 1 },
          "capability_bindings": {
            "type": "array",
            "items": { "$ref": "#/$defs/capabilityBinding" }
          },
          "capability_enforcement": {
            "type": "string",
            "enum": ["shadow", "enforce"]
          },
          "execution_class": {
            "type": "string",
            "enum": ["cognitive", "workspace_patch", "deterministic_check", "human_decision"]
          },
          "required_capabilities": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true
          },
          "preferred_mode": {
            "type": "string",
            "enum": ["interactive", "factory", "deterministic", "human"]
          },
          "execution_hints": {
            "type": "object",
            "required": [
              "estimated_duration_minutes",
              "requires_isolation",
              "requires_resume",
              "background",
              "requires_parallel_execution"
            ],
            "properties": {
              "estimated_duration_minutes": { "type": "number", "minimum": 0 },
              "requires_isolation": { "type": "boolean" },
              "requires_resume": { "type": "boolean" },
              "background": { "type": "boolean" },
              "requires_parallel_execution": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "output_contract": { "type": "string", "enum": ["evidence", "patch", "decision"] },
          "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string", "enum": ["blocks", "feeds", "verifies"] }
        },
        "additionalProperties": false
      }
    },
    "parallel_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "purpose", "node_ids"],
        "properties": {
          "id": { "type": "string" },
          "purpose": { "type": "string" },
          "node_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "merge_policy": { "type": "object" },
    "conflict_policy": { "type": "object" },
    "verification_policy": { "type": "object" },
    "evidence_policy": { "type": "object" },
    "project_knowledge_version": { "type": "integer", "minimum": 0 },
    "project_name": { "type": "string" }
  },
  "$defs": {
    "capabilityBinding": {
      "type": "object",
      "required": [
        "capability_id",
        "capability_version",
        "category",
        "mode",
        "required",
        "priority",
        "target_node_id",
        "execution_class",
        "required_host_capabilities",
        "input_contract",
        "output_contract",
        "protocol_ref",
        "availability",
        "certification"
      ],
      "properties": {
        "capability_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "capability_version": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "enum": ["core", "conditional", "evolution"] },
        "mode": { "type": "string", "enum": ["required", "optional", "advisory"] },
        "required": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": 0 },
        "target_node_id": { "type": "string", "minLength": 1 },
        "execution_class": {
          "type": "string",
          "enum": ["cognitive", "workspace_patch", "deterministic_check", "human_decision"]
        },
        "required_host_capabilities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "uniqueItems": true
        },
        "input_contract": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "output_contract": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "protocol_ref": { "type": "string", "minLength": 1 },
        "availability": {
          "type": "string",
          "enum": ["portable", "host_dependent", "environment_dependent"]
        },
        "certification": {
          "type": "string",
          "enum": ["planned", "bundled", "conformant", "live_verified", "portable_verified"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
