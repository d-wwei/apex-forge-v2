{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/project-knowledge.schema.json",
  "title": "Apex Forge V2 Project Knowledge Manifest",
  "type": "object",
  "required": ["schema_version", "version", "updated_at", "files"],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "version": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose", "owner", "derived", "generated_at", "stale_after", "confidence", "source_refs"],
        "properties": {
          "path": { "type": "string" },
          "purpose": { "type": "string" },
          "owner": { "type": "string" },
          "derived": { "type": "boolean" },
          "generated_at": { "type": "string" },
          "stale_after": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
