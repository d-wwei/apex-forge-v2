{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/execution-policy.schema.json",
  "title": "Apex Forge V2 Execution Policy",
  "type": "object",
  "required": ["schema_version", "updated_at", "budgets", "permissions", "approval"],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "updated_at": { "type": "string" },
    "interactive_workspace_patch": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "interactive_host_claim": {
      "type": "object",
      "required": ["lease_seconds"],
      "properties": {
        "lease_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "execution_router": {
      "type": "object",
      "required": [
        "force_factory_risks",
        "factory_on_isolation",
        "factory_on_resume",
        "factory_on_background",
        "factory_on_parallel_execution"
      ],
      "properties": {
        "factory_min_duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "deprecated": true
        },
        "force_factory_risks": {
          "type": "array",
          "items": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        },
        "factory_on_isolation": { "type": "boolean" },
        "factory_on_resume": { "type": "boolean" },
        "factory_on_background": { "type": "boolean" },
        "factory_on_parallel_execution": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "cost_governor": {
      "type": "object",
      "required": ["enabled", "unknown_usage", "default_budget", "method_pack_budgets"],
      "properties": {
        "enabled": { "type": "boolean" },
        "unknown_usage": { "type": "string", "enum": ["record", "fail"] },
        "default_budget": { "$ref": "#/$defs/routeBudget" },
        "method_pack_budgets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/routeBudget" }
        }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "required": ["max_changed_files_per_patch", "max_patch_bytes", "max_agent_duration_ms", "max_agent_runs_per_tick"],
      "properties": {
        "max_changed_files_per_patch": { "type": "integer", "minimum": 1 },
        "max_patch_bytes": { "type": "integer", "minimum": 1 },
        "max_agent_duration_ms": { "type": "integer", "minimum": 1000 },
        "max_agent_runs_per_tick": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": ["allowed_adapters", "adapter_fallback_order", "adapter_fallback_failure_kinds", "merge_approval_risks", "sensitive_paths"],
      "properties": {
        "allowed_adapters": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "adapter_fallback_order": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "adapter_fallback_failure_kinds": { "type": "array", "items": { "type": "string" } },
        "merge_approval_risks": { "type": "array", "items": { "type": "string", "enum": ["low", "medium", "high", "critical"] } },
        "sensitive_paths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["ttl_minutes", "required_capabilities"],
      "properties": {
        "ttl_minutes": { "type": "integer", "minimum": 1 },
        "required_capabilities": {
          "type": "object",
          "required": ["merge", "adapter_baseline"],
          "properties": {
            "merge": { "type": "string", "const": "merge_apply" },
            "adapter_baseline": { "type": "string", "const": "adapter_baseline_update" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "routeBudget": {
      "type": "object",
      "required": [
        "max_wall_minutes",
        "max_agent_turns",
        "max_tool_calls",
        "max_input_tokens",
        "max_output_tokens"
      ],
      "properties": {
        "max_wall_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "max_agent_turns": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
