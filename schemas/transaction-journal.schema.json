{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/transaction-journal.schema.json",
  "title": "Apex Forge V2 Project Transaction Journal",
  "type": "object",
  "required": [
    "schema_version",
    "transaction_id",
    "kind",
    "idempotency_key",
    "status",
    "started_at",
    "completed_at",
    "recovered_at",
    "backup_path",
    "extra_snapshots",
    "result",
    "error"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "transaction_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["started", "committed", "failed", "recovered"] },
    "started_at": { "type": "string" },
    "completed_at": { "type": ["string", "null"] },
    "recovered_at": { "type": ["string", "null"] },
    "backup_path": { "type": "string", "minLength": 1 },
    "extra_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relative_path", "backup_path", "existed"],
        "properties": {
          "relative_path": { "type": "string", "minLength": 1 },
          "backup_path": { "type": "string", "minLength": 1 },
          "existed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "result": {},
    "error": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
