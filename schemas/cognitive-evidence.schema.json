{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/cognitive-evidence.schema.json",
  "title": "Apex Forge V2 Cognitive Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_type",
    "objective",
    "source_refs",
    "claims",
    "uncertainties",
    "acceptance_mapping",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "evidence_type": { "type": "string", "enum": ["context", "risk", "design", "review"] },
    "objective": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "evidence_ref", "status"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "evidence_ref": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["supported", "partial", "unverified"] }
        },
        "additionalProperties": false
      }
    },
    "affected_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "failure_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "blast_radius": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "mitigations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rollback": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "slices": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "candidate_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "findings": { "type": "array", "items": { "type": "string" } },
    "residual_risks": { "type": "array", "items": { "type": "string" } },
    "merge_posture": { "type": "string", "enum": ["approve", "block", "conditional"] },
    "created_at": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "evidence_type": { "const": "context" } } },
      "then": {
        "properties": {
          "affected_files": {},
          "constraints": {},
          "unknowns": {}
        },
        "required": ["affected_files", "constraints", "unknowns"]
      }
    },
    {
      "if": { "properties": { "evidence_type": { "const": "risk" } } },
      "then": {
        "properties": {
          "failure_paths": {},
          "blast_radius": {},
          "mitigations": {},
          "rollback": {}
        },
        "required": ["failure_paths", "blast_radius", "mitigations", "rollback"]
      }
    },
    {
      "if": { "properties": { "evidence_type": { "const": "design" } } },
      "then": {
        "properties": {
          "slices": {},
          "dependencies": {},
          "verification": {},
          "rollback": {}
        },
        "required": ["slices", "dependencies", "verification", "rollback"]
      }
    },
    {
      "if": { "properties": { "evidence_type": { "const": "review" } } },
      "then": {
        "properties": {
          "candidate_digest": {},
          "findings": {},
          "residual_risks": {},
          "merge_posture": {}
        },
        "required": ["candidate_digest", "findings", "residual_risks", "merge_posture"]
      }
    }
  ],
  "additionalProperties": false
}
