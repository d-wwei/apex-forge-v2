{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-forge.local/v2/schemas/action-workspace.schema.json",
  "title": "Apex Forge V2 Action Workspace",
  "type": "object",
  "required": [
    "schema_version",
    "action_id",
    "worker_id",
    "run_id",
    "status",
    "workspace_path",
    "base_path",
    "base_fingerprint",
    "write_scope",
    "included_file_count",
    "excluded",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "action_id": { "type": "string", "minLength": 1 },
    "worker_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "submitted", "cancelled", "failed"] },
    "workspace_path": { "type": "string", "minLength": 1 },
    "base_path": { "type": "string", "minLength": 1 },
    "base_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "write_scope": { "type": "array", "items": { "type": "string" } },
    "included_file_count": { "type": "integer", "minimum": 0 },
    "excluded": {
      "type": "object",
      "required": ["ignored", "secret", "symlink"],
      "properties": {
        "ignored": { "type": "integer", "minimum": 0 },
        "secret": { "type": "integer", "minimum": 0 },
        "symlink": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
